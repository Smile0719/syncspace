{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start SyncSpace server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*SyncSpace server running on http://0.0.0.0:3000.*"
        }
      }
    }
  ]
}
